# Supabase — only the chat feature needs these. The rest of GAL works without
# them, and the app degrades to "chat unavailable" when they are absent.
#
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The service_role key is NEVER used by this app and must never be added to
# Vercel as a NEXT_PUBLIC_ var. Every read and write goes through RLS.
